        "handoff_contract": {"type": "statistical_execution_result", "schema_version": "1.0.0"},
        "exit_criteria": [
          "All prerequisite parametric assumptions tested on physical data.",
          "Deterministic Python/R execution completed with verified zero mental math.",
          "APA 7 3-line table generated with decoupled LTR numbers."
        ],
        "workspace_mode": "inherit"
      },
      {
        "stage_id": "STG-04-CHL",
        "stage_name": "Adversarial Statistical Challenge",
        "conceptual_role": "Challenger",
        "domain_specialization": "Statistical Challenger",
        "assigned_agent": "academic-challenger",
        "required_skills": ["assumption-testing", "thesis-integrity-auditor"],
        "input_artifacts": ["statistical_results.json", "raw_dataset.csv"],
        "output_artifacts": ["statistical_challenge_report.json"],
        "handoff_contract": {"type": "red_team_challenge_report", "schema_version": "1.0.0"},
        "exit_criteria": [
          "Sensitivity analysis evaluated against extreme cases and outliers.",
          "Model fragility and alternative model specifications tested.",
          "Zero unaddressed critical methodology challenges remaining."
        ],
        "workspace_mode": "inherit"
      },
      {
        "stage_id": "STG-05-AUD",
        "stage_name": "Forensic Quality & Mathematical Audit",
        "conceptual_role": "Auditor",
        "domain_specialization": "Statistical Auditor",
        "assigned_agent": "statistical-auditor",
        "required_skills": ["thesis-integrity-auditor", "apa-reporting"],
        "input_artifacts": ["statistical_results.json", "execution_manifest.json", "statistical_challenge_report.json"],
        "output_artifacts": ["statistical_audit_report.json"],
        "handoff_contract": {"type": "forensic_audit_verdict", "schema_version": "1.0.0"},
        "exit_criteria": [
          "Degrees of freedom verified against sample size N.",
          "Multi-Signal Anomaly Index (MSAI) clean with no variance deflation flags.",
          "Persian leading zero standard preserved (۰.۰۰۱) and p = .000 eliminated."
        ],
        "workspace_mode": "inherit"
      },
      {
        "stage_id": "STG-06-SAUD",
        "stage_name": "Viva Voce Defense & Success Audit",
        "conceptual_role": "Success Auditor",
        "domain_specialization": "Success Auditor",
        "assigned_agent": "final-judge",
        "required_skills": ["persian-defense-presentation-builder", "thesis-integrity-auditor"],
        "input_artifacts": ["statistical_audit_report.json", "statistical_results.json", "apa_table.md"],
        "output_artifacts": ["defense_acceptance_verdict.json"],
        "handoff_contract": {"type": "final_release_clearance", "schema_version": "1.0.0"},
        "exit_criteria": [
          "Viva Voce defense committee simulation cross-examination passed.",
          "Physical deliverable triad (.docx, .md, .json) verified on disk.",
          "Admin Desk (124911145) human approval authorized."
        ],
        "workspace_mode": "inherit"
      }
    ],
    "governance": {
      "directive_0_binary_honesty": true,
      "directive_3_triad_invariant": true,
      "directive_6_english_filenames": true,
      "directive_12_sole_orchestrator": true
    },
    "version": "1.0.0"
  },
