        "input_artifacts": ["research_question.json", "dataset_metadata.json"],
        "output_artifacts": ["candidate_methods.json"],
        "handoff_contract": {"type": "candidate_methods_manifest", "schema_version": "1.0.0"},
        "exit_criteria": [
