{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://academic-suite.net/contracts/evolution/contradiction_record.schema.json",
  "title": "AcademicContradictionRecordContract",
  "description": "Contract schema for contradiction records detected between learned lessons or behavioral instructions, documenting competing directives, conflict types, and mutually exclusive contextual applicability conditions.",
  "type": "object",
  "required": [
    "contract_version",
    "contradiction_id",
    "target_skill",
    "lesson_a_id",
    "lesson_b_id",
    "conflict_type",
    "description",
    "reconciliation_strategy",
    "applicability_conditions",
    "status",
    "detected_at"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "contradiction_id": {
      "type": "string",
      "description": "Unique identifier for this contradiction record (e.g. CTD-20260918-ABCD12)."
    },
    "target_skill": {
      "type": "string",
      "description": "Target skill or capability where the contradiction was identified."
    },
    "lesson_a_id": {
      "type": "string",
      "description": "Existing or baseline lesson identifier."
    },
    "lesson_b_id": {
      "type": "string",
      "description": "Competing or newly generated lesson identifier."
    },
    "conflict_type": {
      "type": "string",
      "enum": [
        "MUTUALLY_EXCLUSIVE_METHODS",
        "CONTRADICTORY_CONSTRAINTS",
        "OPPOSING_RECOMMENDATIONS",
        "INCOMPATIBLE_ASSUMPTIONS",
        "MODEL_SPECIFICATION_CONFLICT"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "Clear explanation of the conflict between the two directives."
    },
    "reconciliation_strategy": {
      "type": "string",
      "enum": [
        "CONTEXTUAL_DISAMBIGUATION",
        "PARAMETRIC_HIERARCHY",
        "DESIGN_CONDITIONAL_BRANCHING",
        "PENDING_HUMAN_RESOLUTION"
      ]
    },
    "applicability_conditions": {
      "type": "object",
      "required": ["condition_for_a", "condition_for_b"],
      "properties": {
        "condition_for_a": {
          "type": "string",
          "minLength": 5,
          "description": "Explicit dataset, design, or research conditions under which Lesson A remains authoritative."
        },
        "condition_for_b": {
          "type": "string",
          "minLength": 5,
          "description": "Explicit dataset, design, or research conditions under which Lesson B becomes authoritative."
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "RESOLVED_WITH_CONDITIONS",
        "PENDING_HUMAN_REVIEW",
        "SUPERSEDED"
      ]
    },
    "detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "reconciled_by": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
