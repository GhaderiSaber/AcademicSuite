{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://academic-suite.net/contracts/evolution/trajectory.schema.json",
  "title": "AcademicTrajectoryContract",
  "description": "Contract schema for observable interaction trajectories. Strictly captures observable actions, tool usages, skill activations, subagent delegations, decisions, and artifacts. Strictly forbids private model chain-of-thought or internal thinking tokens.",
  "type": "object",
  "required": [
    "contract_version",
    "trajectory_id",
    "experience_id",
    "project_id",
    "ordered_actions",
    "tool_usages",
    "skill_activations",
    "subagent_delegations",
    "important_decisions",
    "outputs",
    "validation_events",
    "feedback",
    "outcome"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "trajectory_id": {
      "type": "string",
      "description": "Unique identifier for this trajectory (e.g. TRJ-2026-CH4-001)."
    },
    "experience_id": {
      "type": "string",
      "description": "Pointer to associated experience contract ID."
    },
    "project_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "ordered_actions": {
      "type": "array",
      "description": "Chronologically ordered sequence of observable agent actions. Chain-of-thought is strictly forbidden.",
      "items": {
        "type": "object",
        "required": ["step_number", "action_type", "actor", "timestamp", "description"],
        "properties": {
          "step_number": {
            "type": "integer",
            "minimum": 1
          },
          "action_type": {
            "type": "string",
            "enum": [
              "TOOL_CALL",
              "SKILL_INVOCATION",
              "SUBAGENT_DELEGATION",
              "DECISION_FORMULATION",
              "ARTIFACT_GENERATION",
              "VALIDATION_CHECK",
              "HANDOFF_RETURN"
            ]
          },
          "actor": {
            "type": "string",
            "description": "Agent performing the action (e.g. academic-orchestrator, statistics-agent)."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": "string",
            "description": "High-level summary of the observable action."
          },
          "observable_input": {
            "type": "object",
            "description": "Public, observable inputs or parameters passed to the action."
          },
          "observable_output": {
            "type": "object",
            "description": "Public, observable result returned by the action."
          }
        },
        "additionalProperties": false
      }
    },
    "tool_usages": {
      "type": "array",
      "description": "Structured log of physical tool calls executed during trajectory.",
      "items": {
        "type": "object",
        "required": ["tool_name", "invocation_index", "status"],
        "properties": {
          "tool_name": {
            "type": "string"
          },
          "invocation_index": {
            "type": "integer",
            "minimum": 1
          },
          "arguments_summary": {
            "type": "object",
            "description": "Sanitized tool parameters (paths, flags, options)."
          },
          "status": {
            "type": "string",
            "enum": ["SUCCESS", "ERROR", "TIMEOUT", "BLOCKED_BY_GUARD"]
          },
          "execution_time_ms": {
            "type": "number",
            "minimum": 0
          },
          "error_message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "skill_activations": {
      "type": "array",
      "description": "Skills loaded and executed during the trajectory.",
      "items": {
        "type": "object",
        "required": ["skill_name", "script_path", "exit_code"],
        "properties": {
          "skill_name": {
            "type": "string"
          },
          "script_path": {
            "type": "string"
          },
          "cli_command": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "subagent_delegations": {
      "type": "array",
      "description": "Delegation envelopes sent to and returned by bounded subagents.",
      "items": {
        "type": "object",
        "required": ["delegator", "delegatee", "stage_id", "status"],
        "properties": {
          "delegator": {
            "type": "string"
          },
          "delegatee": {
            "type": "string"
          },
          "stage_id": {
            "type": "string"
          },
          "envelope_summary": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["COMPLETED", "FAILED", "RETRY_REQUESTED"]
          },
          "handoff_artifact_path": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "important_decisions": {
      "type": "array",
      "description": "Strategic decisions journaled during the trajectory.",
      "items": {
        "type": "object",
        "required": ["decision_type", "selected_option", "rationale"],
        "properties": {
          "decision_id": {
            "type": "string"
          },
          "decision_type": {
            "type": "string"
          },
          "selected_option": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "alternatives_considered": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["option", "verdict"],
              "properties": {
                "option": {"type": "string"},
                "verdict": {"type": "string"},
                "reason": {"type": "string"}
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "array",
      "description": "Artifacts produced during the trajectory.",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "type": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "validation_events": {
      "type": "array",
      "description": "Validation executions and verdicts evaluated during trajectory.",
      "items": {
        "type": "object",
        "required": ["validator_name", "verdict"],
        "properties": {
          "validator_name": {"type": "string"},
          "verdict": {
            "type": "string",
            "enum": ["PASS", "FAIL", "BLOCKED", "INCOMPLETE"]
          },
          "failed_checks": {
            "type": "array",
            "items": {"type": "string"}
          },
          "evidence_summary": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "feedback": {
      "type": "array",
      "description": "List of feedback IDs received during or at completion of trajectory.",
      "items": {
        "type": "string"
      }
    },
    "outcome": {
      "type": "string",
      "enum": ["SUCCESS", "FAILURE", "REVISED", "BLOCKED"]
    }
  },
  "patternProperties": {
    "^(?!chain_of_thought|thinking|internal_monologue|scratchpad|reasoning_tokens).*$": {}
  },
  "not": {
    "anyOf": [
      {"required": ["chain_of_thought"]},
      {"required": ["thinking"]},
      {"required": ["internal_monologue"]},
      {"required": ["scratchpad"]},
      {"required": ["reasoning_tokens"]}
    ]
  },
  "additionalProperties": false
}
