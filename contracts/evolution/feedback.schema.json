{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://academic-suite.net/contracts/evolution/feedback.schema.json",
  "title": "AcademicFeedbackContract",
  "description": "Contract schema for human supervisor and automated critique feedback, capturing corrections, desired behaviors, and severity.",
  "type": "object",
  "required": [
    "contract_version",
    "feedback_id",
    "source",
    "type",
    "target_agent",
    "target_skill",
    "correction",
    "desired_behavior",
    "scope",
    "severity",
    "timestamp"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "feedback_id": {
      "type": "string",
      "description": "Unique identifier for this feedback entry (e.g. FDB-2026-CH4-001)."
    },
    "source": {
      "type": "object",
      "required": ["origin", "identifier"],
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "HUMAN_SUPERVISOR",
            "ADMIN_DESK_124911145",
            "ACADEMIC_CHALLENGER",
            "VALIDATION_SUITE",
            "PEER_AGENT",
            "EXTERNAL_EXAMINER"
          ]
        },
        "identifier": {
          "type": "string",
          "description": "Name or ID of the human or agent providing feedback (e.g. GhaderiSaber, academic-challenger)."
        }
      },
      "additionalProperties": false
    },
    "type": {
      "type": "string",
      "enum": [
        "METHODOLOGY_CORRECTION",
        "STATISTICAL_CORRECTION",
        "DATA_ANALYSIS_CORRECTION",
        "WRITING_CORRECTION",
        "EVIDENCE_CORRECTION",
        "COMPLETENESS_CORRECTION",
        "PROCESS_CORRECTION",
        "RESEARCH_INTEGRITY_CORRECTION",
        "QUALITY_STYLE_CORRECTION",
        "METHODOLOGICAL_CORRECTION",
        "TYPOGRAPHY_CORRECTION",
        "CITATION_CORRECTION",
        "CRITIQUE",
        "STIPULATION",
        "PREFERENCE"
      ]
    },
    "target_agent": {
      "type": "string",
      "description": "Cognitive agent responsible for the behavior (e.g. statistics-agent, academic-writer)."
    },
    "target_skill": {
      "type": "string",
      "description": "Skill implicated in the feedback (e.g. assumption-testing, apa-reporting)."
    },
    "correction": {
      "type": "string",
      "minLength": 5,
      "description": "Factual description of what was incorrect, flawed, or rejected."
    },
    "desired_behavior": {
      "type": "string",
      "minLength": 5,
      "description": "Explicit description of the expected standard or compliant behavior."
    },
    "scope": {
      "type": "string",
      "enum": [
        "PROJECT_SPECIFIC",
        "REUSABLE_PROCEDURAL",
        "POTENTIAL_GLOBAL_INVARIANT",
        "DOMAIN_WIDE",
        "UNIVERSAL"
      ],
      "description": "Scope of applicability: whether the feedback applies only to this project, procedural reuse, or global system invariant."
    },
    "severity": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "is_correction": {
      "type": "boolean",
      "description": "Whether this feedback represents an active behavioral correction."
    },
    "is_project_specific": {
      "type": "boolean",
      "description": "Whether this feedback is scoped strictly to the current project."
    },
    "context": {
      "type": "object",
      "properties": {
        "project_id": {"type": "string"},
        "milestone_id": {"type": "string"},
        "stage_id": {"type": "string"},
        "source_transcript_path": {"type": "string"},
        "turn_index": {"type": "integer"},
        "related_artifact_paths": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "generalization_candidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "suggested_rule",
        "scope",
        "repetition_count",
        "signature_hash",
        "evaluation_status"
      ],
      "properties": {
        "candidate_id": {"type": "string"},
        "suggested_rule": {"type": "string", "minLength": 5},
        "suggested_target_skill": {"type": "string"},
        "scope": {
          "type": "string",
          "enum": [
            "PROJECT_SPECIFIC",
            "REUSABLE_PROCEDURAL",
            "POTENTIAL_GLOBAL_INVARIANT",
            "DOMAIN_WIDE",
            "UNIVERSAL"
          ]
        },
        "repetition_count": {"type": "integer", "minimum": 1},
        "signature_hash": {"type": "string"},
        "evaluation_status": {
          "type": "string",
          "enum": ["PENDING", "FLAGGED_FALSE_POSITIVE", "CONFIRMED_VALID"]
        },
        "flag_rationale": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
