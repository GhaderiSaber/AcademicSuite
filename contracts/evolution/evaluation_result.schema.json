{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://academic-suite.net/contracts/evolution/evaluation_result.schema.json",
  "title": "AcademicEvaluationResultContract",
  "description": "Authoritative canonical contract schema for all evaluation results (EvaluationResult) across AcademicSuite. Unifies evaluation lab, independent blinded evaluation, and multi-arm suites into one universal structure with 13 mandatory fields. Strictly forbids single-number scalar intelligence scores.",
  "type": "object",
  "required": [
    "evaluation_id",
    "candidate_id",
    "baseline_id",
    "task_id",
    "dimensions",
    "baseline_metrics",
    "candidate_metrics",
    "regression_results",
    "adversarial_results",
    "heldout_results",
    "contradictions",
    "evidence",
    "verdict"
  ],
  "properties": {
    "evaluation_id": {
      "type": "string",
      "description": "Unique identifier for this evaluation result report (e.g. EVR-20260919-001 or INDEP-EVL-...).",
      "minLength": 3
    },
    "candidate_id": {
      "type": "string",
      "description": "Identifier of the candidate agent, mutation, or improvement under evaluation.",
      "minLength": 2
    },
    "baseline_id": {
      "type": "string",
      "description": "Identifier, commit hash, or version string of the baseline agent used for comparative evaluation.",
      "minLength": 2
    },
    "task_id": {
      "type": "string",
      "description": "Identifier of the benchmark task, evaluation panel, or test case executed.",
      "minLength": 2
    },
    "dimensions": {
      "type": "object",
      "description": "Multidimensional performance evaluations across quality dimensions (correctness, methodology, statistical_validity, evidence_grounding, integrity, robustness, consistency, efficiency).",
      "additionalProperties": true
    },
    "baseline_metrics": {
      "type": "object",
      "description": "Detailed performance metrics achieved by the baseline arm.",
      "additionalProperties": true
    },
    "candidate_metrics": {
      "type": "object",
      "description": "Detailed performance metrics achieved by the candidate arm.",
      "additionalProperties": true
    },
    "regression_results": {
      "type": "object",
      "description": "Evaluation results on the regression suite ensuring no protected capabilities or previous capabilities regressed.",
      "required": ["verdict"],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["PASS", "FAIL", "INCONCLUSIVE", "CONDITIONAL", "UNKNOWN"]
        },
        "evidence_status": {
          "type": "string",
          "enum": ["VERIFIED", "MISSING", "INCOMPLETE"]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "details": {
          "type": "array"
        },
        "fixes_original_mistake": {
          "type": "boolean"
        },
        "task_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "adversarial_results": {
      "type": "object",
      "description": "Evaluation results on the adversarial red-team suite ensuring candidate resilience against edge cases and attacks.",
      "required": ["verdict"],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["PASS", "FAIL", "INCONCLUSIVE", "CONDITIONAL", "UNKNOWN"]
        },
        "evidence_status": {
          "type": "string",
          "enum": ["VERIFIED", "MISSING", "INCOMPLETE"]
        },
        "creates_new_mistake": {
          "type": "boolean"
        },
        "task_id": {
          "type": "string"
        },
        "details": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "heldout_results": {
      "type": "object",
      "description": "Evaluation results on cryptographically sealed held-out evaluation scenarios ensuring out-of-distribution generalization.",
      "required": ["verdict"],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["PASS", "FAIL", "INCONCLUSIVE", "CONDITIONAL", "UNKNOWN"]
        },
        "evidence_status": {
          "type": "string",
          "enum": ["VERIFIED", "MISSING", "INCOMPLETE"]
        },
        "pass_rate": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "generalizes_to_different_case": {
          "type": "boolean"
        },
        "overfitting_detected": {
          "type": "boolean"
        },
        "overfitting_reason": {
          "type": ["string", "null"]
        },
        "total_cases": {
          "type": "integer",
          "minimum": 0
        },
        "task_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "contradictions": {
      "type": ["array", "object"],
      "description": "Contradiction records, conflict analysis items, or consistency checks evaluated during testing."
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "description": "Cryptographic evidence records, artifact paths, and SHA256 hashes verifying evaluation outputs.",
      "items": {
        "type": "object",
        "required": ["artifact_path", "sha256"],
        "properties": {
          "artifact_path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "evidence_type": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "INCONCLUSIVE", "CONDITIONAL", "UNKNOWN"],
      "description": "Authoritative overall verdict of the evaluation."
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "recommendation": {
      "type": "string",
      "enum": ["PROMOTE", "STAGE_FOR_REVIEW", "REJECT"]
    },
    "baseline_version": {
      "type": "string"
    },
    "overall_verdict": {
      "type": "string"
    },
    "metrics": {
      "type": "object"
    },
    "summary_metrics": {
      "type": "object"
    },
    "dimensional_evaluations": {
      "type": "object"
    },
    "diagnostics": {
      "type": "array"
    },
    "regressions": {
      "type": "object"
    },
    "failures": {
      "type": "array"
    },
    "unblinded_comparison": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  },
  "patternProperties": {
    "^(?!overall_intelligence|agent_iq|general_intelligence_score|smartness_rating).*$": {}
  },
  "not": {
    "anyOf": [
      {"required": ["overall_intelligence"]},
      {"required": ["agent_iq"]},
      {"required": ["general_intelligence_score"]},
      {"required": ["smartness_rating"]}
    ]
  },
  "additionalProperties": true
}
