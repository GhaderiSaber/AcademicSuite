{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://academic-suite.net/contracts/evolution/evaluation_result.schema.json",
  "title": "AcademicEvaluationResultContract",
  "description": "Contract schema for comparative evaluation results between candidate and baseline. Strictly preserves multidimensional metrics and forbids single-number scalar intelligence scores.",
  "type": "object",
  "required": [
    "contract_version",
    "evaluation_id",
    "candidate_id",
    "baseline_version",
    "metrics",
    "diagnostics",
    "regressions",
    "failures",
    "evidence",
    "overall_verdict",
    "evaluated_at"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "evaluation_id": {
      "type": "string",
      "description": "Unique identifier for this evaluation report (e.g. EVR-2026-001)."
    },
    "candidate_id": {
      "type": "string",
      "description": "Pointer to the candidate improvement ID tested."
    },
    "baseline_version": {
      "type": "string",
      "description": "Version hash or git commit of the baseline active behavior."
    },
    "metrics": {
      "type": "object",
      "description": "Multidimensional performance metrics. Monolithic intelligence scores are strictly forbidden.",
      "required": [
        "statistical_precision",
        "typography_compliance",
        "execution_reliability",
        "msai_anomaly_score"
      ],
      "properties": {
        "statistical_precision": {
          "type": "object",
          "required": ["df_concordance_rate", "fit_index_pass_rate"],
          "properties": {
            "df_concordance_rate": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "fit_index_pass_rate": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "parameter_error_margin": {
              "type": "number",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        },
        "typography_compliance": {
          "type": "object",
          "required": ["persian_leading_zero_violations", "apa_table_border_violations"],
          "properties": {
            "persian_leading_zero_violations": {
              "type": "integer",
              "minimum": 0
            },
            "apa_table_border_violations": {
              "type": "integer",
              "minimum": 0
            },
            "prohibited_cliche_count": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "execution_reliability": {
          "type": "object",
          "required": ["successful_runs", "total_runs", "crash_count"],
          "properties": {
            "successful_runs": {"type": "integer", "minimum": 0},
            "total_runs": {"type": "integer", "minimum": 1},
            "crash_count": {"type": "integer", "minimum": 0},
            "average_latency_seconds": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        },
        "msai_anomaly_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 100.0,
          "description": "Multi-Signal Anomaly Index (0-100)."
        }
      },
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "status", "finding"],
        "properties": {
          "check_id": {"type": "string"},
          "status": {
            "type": "string",
            "enum": ["PASS", "FAIL", "NEEDS_REVIEW"]
          },
          "finding": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "regressions": {
      "type": "object",
      "required": ["count", "details"],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of previously passing tests that failed under the candidate."
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["case_id", "baseline_verdict", "candidate_verdict", "regression_error"],
            "properties": {
              "case_id": {"type": "string"},
              "baseline_verdict": {"type": "string"},
              "candidate_verdict": {"type": "string"},
              "regression_error": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test_id", "error_message"],
        "properties": {
          "test_id": {"type": "string"},
          "error_message": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_path", "sha256"],
        "properties": {
          "artifact_path": {"type": "string"},
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "evidence_type": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "overall_verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "INCONCLUSIVE"]
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "dimensional_evaluations": {
      "type": "object",
      "description": "Independent evaluation metrics across the 8 mandatory dimensions. Never collapsed into a single scalar score.",
      "properties": {
        "correctness": {"type": "object"},
        "methodology": {"type": "object"},
        "statistical_validity": {"type": "object"},
        "evidence_grounding": {"type": "object"},
        "integrity": {"type": "object"},
        "robustness": {"type": "object"},
        "consistency": {"type": "object"},
        "efficiency": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^(?!overall_intelligence|agent_iq|general_intelligence_score|smartness_rating).*$": {}
  },
  "not": {
    "anyOf": [
      {"required": ["overall_intelligence"]},
      {"required": ["agent_iq"]},
      {"required": ["general_intelligence_score"]},
      {"required": ["smartness_rating"]}
    ]
  },
  "additionalProperties": false
}
