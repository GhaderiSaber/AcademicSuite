{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://academic-suite.net/contracts/execution_manifest.schema.json",
  "title": "AcademicExecutionManifestContract",
  "description": "Contract schema for deterministic batch pipeline execution manifests passed to Layer 4 CLI runners.",
  "type": "object",
  "required": [
    "contract_version",
    "manifest_id",
    "project_id",
    "milestone_id",
    "execution_environment",
    "steps",
    "dry_run"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "manifest_id": {
      "type": "string",
      "description": "Unique identifier for this execution manifest (e.g. MANIFEST-2026-CH4-001)."
    },
    "project_id": {
      "type": "string"
    },
    "milestone_id": {
      "type": "string"
    },
    "generated_by": {
      "type": "string",
      "description": "Conductor agent generating this manifest (e.g. academic-orchestrator)."
    },
    "execution_mode": {
      "type": "string",
      "enum": ["production", "demo", "test"],
      "description": "Execution context mode strictly separating live empirical production from demo/test."
    },
    "timestamp": {
      "type": "string",
      "description": "ISO-8601 timestamp of manifest generation."
    },
    "analysis_plan_hash": {
      "type": "string",
      "description": "SHA-256 cryptographic hash of the input AnalysisPlan artifact."
    },
    "input_dataset_hash": {
      "type": "string",
      "description": "SHA-256 cryptographic hash of the input dataset file."
    },
    "code_identity": {
      "type": "string",
      "description": "Identifier and/or SHA-256 cryptographic hash of the execution script."
    },
    "command": {
      "type": "string",
      "description": "Full CLI command invoked for execution."
    },
    "exit_code": {
      "type": "integer",
      "description": "Exit status code returned by the execution process."
    },
    "produced_artifacts": {
      "type": "array",
      "description": "List of artifacts produced by execution with hashes and paths.",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string"},
          "type": {"type": "string"}
        }
      }
    },
    "execution_environment": {
      "type": "object",
      "required": ["working_directory", "python_interpreter"],
      "properties": {
        "working_directory": {"type": "string"},
        "python_interpreter": {"type": "string"},
        "r_script_binary": {"type": "string"},
        "environment_variables": {"type": "object"}
      }
    },
    "dry_run": {
      "type": "boolean",
      "description": "If true, validates artifact existence and dependencies without executing scripts."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "step_number",
          "stage_id",
          "capability",
          "assigned_subagent",
          "skill_name",
          "script_path",
          "input_artifacts",
          "output_artifacts",
          "timeout_seconds",
          "required_validation"
        ],
        "properties": {
          "step_number": {"type": "integer", "minimum": 1},
          "stage_id": {"type": "string"},
          "capability": {"type": "string"},
          "assigned_subagent": {
            "type": "string",
            "enum": [
              "research-agent",
              "literature-expert",
              "data-agent",
              "data-curator",
              "statistics-agent",
              "psychometric-expert",
              "longitudinal-modmed-expert",
              "meta-analyst",
              "qualitative-analyst",
              "academic-writer",
              "validation-agent",
              "results-auditor",
              "statistical-auditor"
            ]
          },
          "skill_name": {"type": "string"},
          "script_path": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_/.-]+$"
          },
          "cli_arguments": {
            "type": "array",
            "items": {"type": "string"}
          },
          "input_artifacts": {
            "type": "array",
            "items": {"type": "string"}
          },
          "output_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 5,
            "maximum": 3600
          },
          "required_validation": {
            "type": "object",
            "required": ["validator_suite_required", "expected_verdict"],
            "properties": {
              "validator_suite_required": {"type": "boolean"},
              "validator_script": {"type": "string"},
              "expected_verdict": {
                "type": "string",
                "enum": ["PASS"]
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
