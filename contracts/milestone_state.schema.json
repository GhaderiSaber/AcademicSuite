{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://academic-suite.net/contracts/milestone_state.schema.json",
  "title": "AcademicMilestoneStateContract",
  "description": "Contract schema for tracking project milestone lifecycle state, active agents, artifact dependencies, and validation progress.",
  "type": "object",
  "required": [
    "contract_version",
    "milestone_id",
    "title",
    "project_id",
    "status",
    "current_stage",
    "active_agent",
    "stages_sequence",
    "produced_artifacts",
    "validation_summary",
    "approval_state",
    "timestamps",
    "retry_tracking"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "milestone_id": {
      "type": "string",
      "description": "Milestone identifier (e.g. M1_PROPOSAL, M2_DATA_CURATION, M3_ANALYSIS, M4_CHAPTER4, M5_DEFENSE)."
    },
    "title": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "CREATED",
        "SCOPED",
        "PLANNED",
        "READY",
        "RUNNING",
        "VALIDATING",
        "AWAITING_APPROVAL",
        "APPROVED",
        "FAILED",
        "REJECTED",
        "SUPERSEDED",
        "PENDING",
        "IN_PROGRESS",
        "APPROVAL_PENDING",
        "COMPLETED",
        "BLOCKED"
      ]
    },
    "current_stage": {
      "type": "string",
      "description": "Current micro-stage ID (e.g. 06_hypothesis_1)."
    },
    "active_agent": {
      "type": "string",
      "description": "Currently active durable agent or subagent executing the milestone."
    },
    "stages_sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stage_id", "title", "assigned_role", "status"],
        "properties": {
          "stage_id": {"type": "string"},
          "title": {"type": "string"},
          "assigned_role": {"type": "string"},
          "status": {
            "type": "string",
            "enum": ["NOT_STARTED", "RUNNING", "PASSED_VALIDATION", "FAILED_VALIDATION", "COMPLETED"]
          },
          "triad_completed": {"type": "boolean"}
        }
      }
    },
    "input_artifacts": {
      "type": "array",
      "items": {"type": "string"}
    },
    "produced_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "type", "validation_verdict"],
        "properties": {
          "artifact_id": {"type": "string"},
          "path": {"type": "string"},
          "type": {"type": "string"},
          "validation_verdict": {
            "type": "string",
            "enum": ["PASS", "FAIL", "NEEDS_REVIEW", "UNVALIDATED"]
          }
        }
      }
    },
    "validation_summary": {
      "type": "object",
      "required": ["overall_verdict", "total_checks_run", "failed_checks_count"],
      "properties": {
        "overall_verdict": {
          "type": "string",
          "enum": ["PASS", "FAIL", "NEEDS_REVIEW", "BLOCKED", "INCOMPLETE", "UNKNOWN"]
        },
        "total_checks_run": {"type": "integer", "minimum": 0},
        "failed_checks_count": {"type": "integer", "minimum": 0},
        "last_validation_report_path": {"type": "string"}
      }
    },
    "approval_state": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["APPROVAL_NOT_REQUIRED", "APPROVAL_PENDING", "APPROVAL_GRANTED", "APPROVAL_REJECTED"]
        },
        "approval_id": {"type": "string"},
        "approved_by": {"type": "string"},
        "decided_at": {"type": "string", "format": "date-time"}
      }
    },
    "timestamps": {
      "type": "object",
      "required": ["created_at", "updated_at"],
      "properties": {
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"}
      }
    },
    "retry_tracking": {
      "type": "object",
      "required": ["retry_count", "max_retries"],
      "properties": {
        "retry_count": {"type": "integer", "minimum": 0},
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 5},
        "last_failure_reason": {"type": "string"}
      }
    }
  },
  "additionalProperties": true
}
