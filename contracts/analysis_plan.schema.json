{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://academic-suite.net/contracts/analysis_plan.schema.json",
  "title": "AcademicAnalysisPlanContract",
  "description": "Authoritative contract schema for academic analysis plans, strictly separating statistical decision from deterministic execution.",
  "type": "object",
  "required": [
    "contract_version",
    "plan_id",
    "research_questions",
    "hypotheses",
    "design",
    "variables",
    "estimands",
    "statistical_models",
    "assumptions",
    "missing_data_strategy",
    "exclusion_rules",
    "effect_size_specifications",
    "confidence_intervals",
    "multiple_testing_strategy",
    "diagnostics",
    "required_tables",
    "required_figures",
    "execution_specification"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the contract schema."
    },
    "plan_id": {
      "type": "string",
      "description": "Unique identifier for this analysis plan (e.g. PLAN-2026-CH4-001)."
    },
    "project_id": {
      "type": "string",
      "description": "Identifier of the associated research project."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "decided_by": {
      "type": "string",
      "description": "Durable authority who formulated the plan (e.g. statistical-expert, methodology-expert)."
    },
    "research_questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "question"],
        "properties": {
          "id": {"type": "string"},
          "question": {"type": "string"},
          "target_variables": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "type", "direction", "independent_variable", "dependent_variable"],
        "properties": {
          "id": {"type": "string"},
          "statement": {"type": "string"},
          "type": {
            "type": "string",
            "enum": ["direct", "indirect_mediation", "moderation", "moderated_mediation", "group_comparison", "measurement_cfa", "correlation"]
          },
          "direction": {
            "type": "string",
            "enum": ["positive", "negative", "non_directional", "moderated"]
          },
          "independent_variable": {"type": "string"},
          "dependent_variable": {"type": "string"},
          "mediator_variables": {
            "type": "array",
            "items": {"type": "string"}
          },
          "moderator_variables": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "design": {
      "type": "object",
      "required": ["type", "time_structure", "grouping"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["experimental", "quasi_experimental", "correlational", "longitudinal", "cfa_scale_validation", "meta_analysis", "mixed_methods"]
        },
        "time_structure": {
          "type": "string",
          "enum": ["cross_sectional", "pre_post_repeated_measures", "3_wave_longitudinal_panel", "multi_wave_time_series"]
        },
        "grouping": {
          "type": "object",
          "required": ["is_grouped"],
          "properties": {
            "is_grouped": {"type": "boolean"},
            "group_variable": {"type": "string"},
            "levels": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        },
        "power_analysis": {
          "type": "object",
          "properties": {
            "target_power": {"type": "number", "minimum": 0.5, "maximum": 0.999},
            "significance_alpha": {"type": "number", "minimum": 0.001, "maximum": 0.1},
            "required_n": {"type": "integer", "minimum": 10},
            "software": {"type": "string"}
          }
        }
      }
    },
    "variables": {
      "type": "object",
      "required": ["outcome_variables", "predictors"],
      "properties": {
        "outcome_variables": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "predictors": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "covariates": {
          "type": "array",
          "items": {"type": "string"}
        },
        "mediators": {
          "type": "array",
          "items": {"type": "string"}
        },
        "moderators": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "estimands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "target_parameter"],
        "properties": {
          "id": {"type": "string"},
          "description": {"type": "string"},
          "target_parameter": {
            "type": "string",
            "enum": ["average_treatment_effect", "direct_path_coefficient", "indirect_mediation_effect", "interaction_index", "factor_loading", "correlation_coefficient", "r_squared"]
          }
        }
      }
    },
    "statistical_models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["model_id", "family"],
        "properties": {
          "model_id": {"type": "string"},
          "family": {
            "type": "string",
            "enum": ["linear_regression", "sem_structural_equation_modeling", "cfa_confirmatory_factor_analysis", "ancova_analysis_of_covariance", "repeated_measures_anova", "process_model_4_mediation", "process_model_1_moderation", "process_model_7_modmed", "meta_analytic_random_effects"]
          },
          "estimator": {"type": "string"},
          "specification": {"type": "string"}
        }
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["test_name", "target", "threshold", "action_on_violation"],
        "properties": {
          "test_name": {"type": "string"},
          "target": {"type": "string"},
          "threshold": {"type": "string"},
          "action_on_violation": {"type": "string"}
        }
      }
    },
    "missing_data_strategy": {
      "type": "object",
      "required": ["strategy", "mcar_diagnostic_required", "maximum_allowed_missing_rate"],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["listwise_deletion", "fiml_full_information_maximum_likelihood", "multiple_imputation_chained_equations", "multiple_imputation", "expectation_maximization"]
        },
        "mcar_diagnostic_required": {"type": "boolean"},
        "maximum_allowed_missing_rate": {"type": "number", "minimum": 0.0, "maximum": 0.5},
        "mean_imputation_prohibited": {"type": "boolean", "const": true}
      }
    },
    "exclusion_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "criterion", "action"],
        "properties": {
          "rule_id": {"type": "string"},
          "criterion": {"type": "string"},
          "action": {"type": "string", "enum": ["flag_for_review", "exclude_from_analysis", "winsorize"]}
        }
      }
    },
    "effect_size_specifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["metric", "benchmark_scale"],
        "properties": {
          "metric": {
            "type": "string",
            "enum": ["cohen_d", "partial_eta_squared", "standardized_beta", "hedges_g", "odds_ratio", "cohen_f2"]
          },
          "benchmark_scale": {"type": "string"}
        }
      }
    },
    "confidence_intervals": {
      "type": "object",
      "required": ["confidence_level", "estimation_method"],
      "properties": {
        "confidence_level": {"type": "number", "minimum": 0.80, "maximum": 0.999},
        "estimation_method": {
          "type": "string",
          "enum": ["bca_bias_corrected_accelerated_bootstrap", "percentile_bootstrap", "normal_theory"]
        },
        "bootstrap_resamples": {"type": "integer", "minimum": 1000}
      }
    },
    "multiple_testing_strategy": {
      "type": "object",
      "required": ["correction_method"],
      "properties": {
        "correction_method": {
          "type": "string",
          "enum": ["none_planned_orthogonal_hypotheses", "benjamini_hochberg_fdr", "bonferroni", "holm_bonferroni"]
        },
        "family_definition": {"type": "string"}
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {"type": "string"}
    },
    "required_tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["table_id", "title", "standard"],
        "properties": {
          "table_id": {"type": "string"},
          "title": {"type": "string"},
          "standard": {"type": "string", "enum": ["apa_7_three_line", "apa_7_sem_macro", "apa_7_descriptive_demographic"]}
        }
      }
    },
    "required_figures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["figure_id", "type", "dpi"],
        "properties": {
          "figure_id": {"type": "string"},
          "type": {"type": "string"},
          "dpi": {"type": "integer", "minimum": 300}
        }
      }
    },
    "execution_specification": {
      "type": "object",
      "description": "Deterministic execution details ('The Hands') decoupled from statistical reasoning.",
      "required": ["assigned_subagent", "engine", "scripts", "expected_triad_artifacts"],
      "properties": {
        "assigned_subagent": {
          "type": "string",
          "enum": ["statistics-agent", "data-agent", "psychometric-expert", "longitudinal-modmed-expert", "meta-analyst"]
        },
        "engine": {
          "type": "string",
          "enum": ["python", "r", "python_r"]
        },
        "scripts": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "cli_arguments": {
          "type": "object"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600
        },
        "expected_triad_artifacts": {
          "type": "object",
          "required": ["docx_path", "md_path", "json_path"],
          "properties": {
            "docx_path": {"type": "string"},
            "md_path": {"type": "string"},
            "json_path": {"type": "string"}
          }
        }
      }
    }
  },
  "additionalProperties": true
}
