{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://academic-suite.net/contracts/handoff.schema.json",
  "title": "AcademicAgentHandoffContract",
  "description": "Contract schema for inter-agent delegation envelopes and artifact handoffs in Google Antigravity.",
  "type": "object",
  "required": [
    "contract_version",
    "handoff_id",
    "milestone_id",
    "stage_id",
    "source_agent",
    "target_agent",
    "timestamp",
    "delegation_envelope",
    "input_artifacts",
    "expected_outputs",
    "completion_criteria"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "handoff_id": {
      "type": "string",
      "description": "Unique identifier for the handoff record (e.g. HND-2026-CH4-001)."
    },
    "milestone_id": {
      "type": "string"
    },
    "stage_id": {
      "type": "string"
    },
    "source_agent": {
      "type": "string",
      "description": "Delegating agent (e.g. academic-orchestrator, statistical-expert, academic-writer)."
    },
    "target_agent": {
      "type": "string",
      "description": "Assigned subagent (e.g. statistics-agent, data-agent, results-auditor)."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "delegation_envelope": {
      "type": "object",
      "required": ["task_summary", "prompt_instructions", "context_bounds"],
      "properties": {
        "task_summary": {"type": "string"},
        "prompt_instructions": {"type": "string"},
        "context_bounds": {
          "type": "object",
          "required": ["allowed_tools", "workspace_mode"],
          "properties": {
            "allowed_tools": {
              "type": "array",
              "items": {"type": "string"}
            },
            "workspace_mode": {
              "type": "string",
              "enum": ["inherit", "branch", "share"]
            },
            "model_tier": {
              "type": "string",
              "enum": ["flash_lite", "flash", "pro", "inherit"]
            }
          }
        }
      }
    },
    "input_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "validation_status"],
        "properties": {
          "artifact_id": {"type": "string"},
          "path": {"type": "string"},
          "validation_status": {"type": "string"}
        }
      }
    },
    "expected_outputs": {
      "type": "object",
      "required": ["triad_required"],
      "properties": {
        "triad_required": {"type": "boolean"},
        "expected_files": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "completion_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "return_payload": {
      "type": "object",
      "description": "Filled upon subagent completion. Under Phase 21, must contain artifact, evidence, status, and validation.",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["SUCCESS", "FAILURE", "FAILED", "BLOCKED"]
        },
        "artifact": {
          "description": "Deliverable files produced on disk (array or object)."
        },
        "evidence": {
          "type": "object",
          "description": "Exact statistical parameters, test statistics, and findings."
        },
        "validation": {
          "type": "object",
          "description": "Validation verdict and report details."
        },
        "produced_artifacts": {
          "type": "array",
          "items": {"type": "string"}
        },
        "validation_verdict": {
          "type": "string",
          "enum": ["PASS", "FAIL", "NEEDS_REVIEW", "BLOCKED", "INCOMPLETE", "UNKNOWN"]
        },
        "execution_time_seconds": {"type": "number"}
      }
    }
  },
  "additionalProperties": true
}
