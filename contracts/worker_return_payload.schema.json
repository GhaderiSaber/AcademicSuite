{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://academic-suite.net/contracts/worker_return_payload.schema.json",
  "title": "WorkerReturnPayloadContract",
  "description": "Authoritative contract schema for structured worker subagent return payloads in AcademicSuite. Enforces the 4-part return invariant: artifact, evidence, status, validation. Strictly forbids trivial string returns like 'done'.",
  "type": "object",
  "anyOf": [
    {
      "required": [
        "artifact",
        "evidence",
        "status",
        "validation"
      ]
    },
    {
      "required": [
        "artifacts",
        "evidence",
        "status",
        "validation"
      ]
    }
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\.[0-9]+\.[0-9]+$",
      "default": "1.0.0",
      "description": "Contract semantic version."
    },
    "worker_agent": {
      "type": "string",
      "description": "Specialist worker subagent identifier (e.g. statistics-agent, data-agent, academic-writer)."
    },
    "stage_id": {
      "type": "string",
      "description": "Identifier of the target stage (e.g. 01_demographics, 06_hypothesis_1)."
    },
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "FAILED", "BLOCKED"],
      "description": "Machine-readable execution status of the worker subagent."
    },
    "artifact": {
      "description": "Non-empty list of generated deliverable artifact file paths or structured artifact records on disk.",
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "path": {"type": "string", "minLength": 1},
                  "sha256": {"type": "string"},
                  "artifact_type": {"type": "string"}
                }
              }
            ]
          }
        },
        {
          "type": "object",
          "minProperties": 1
        }
      ]
    },
    "artifacts": {
      "description": "Non-empty list of generated deliverable artifact file paths or structured artifact records on disk (Phase 22).",
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "path": {"type": "string", "minLength": 1},
                  "sha256": {"type": "string"},
                  "artifact_type": {"type": "string"}
                }
              }
            ]
          }
        },
        {
          "type": "object",
          "minProperties": 1
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Operational warnings, data quality flags, or execution anomalies encountered (Phase 22)."
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Statistical or methodological limitations encountered (Phase 22)."
    },
    "evidence": {
      "type": "object",
      "minProperties": 1,
      "description": "Factual computational parameters, test statistics, effect sizes, sample size, degrees of freedom, and empirical findings."
    },
    "validation": {
      "type": "object",
      "required": ["verdict"],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["PASS", "FAIL", "NEEDS_REVIEW", "BLOCKED"]
        },
        "overall_verdict": {
          "type": "string",
          "enum": ["PASS", "FAIL", "NEEDS_REVIEW", "BLOCKED"]
        },
        "report_path": {
          "type": "string"
        },
        "checks_passed": {
          "type": "integer",
          "minimum": 0
        },
        "checks_failed": {
          "type": "integer",
          "minimum": 0
        },
        "diagnostics": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "execution_telemetry": {
      "type": "object",
      "properties": {
        "command": {"type": "string"},
        "exit_code": {"type": "integer"},
        "execution_time_seconds": {"type": "number"},
        "memory_mb": {"type": "number"}
      },
      "additionalProperties": true
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
