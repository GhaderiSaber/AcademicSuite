{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://academic-suite.net/contracts/teamwork_pattern.schema.json",
  "title": "AcademicSuite Teamwork Pattern Contract",
  "description": "Authoritative contract defining academic domain collaboration patterns mapped to Antigravity conceptual roles (Explorer, Worker, Critic, Challenger, Auditor, Success Auditor).",
  "type": "object",
  "required": [
    "pattern_id",
    "pattern_name",
    "description",
    "target_pipeline",
    "conceptual_roles",
    "workflow_stages",
    "governance"
  ],
  "properties": {
    "pattern_id": {
      "type": "string",
      "pattern": "^ATP-[A-Z0-9_-]+$",
      "description": "Unique identifier for the academic teamwork pattern (e.g. ATP-METHODOLOGY-INFERENCE-001)."
    },
    "pattern_name": {
      "type": "string",
      "minLength": 5,
      "description": "Scholarly name of the academic teamwork pattern."
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "Detailed explanation of where and why this teamwork pattern is applied."
    },
    "target_pipeline": {
      "type": "string",
      "enum": [
        "METHODOLOGY_INFERENCE",
        "CHAPTER_4_FINDINGS",
        "CHAPTER_5_DISCUSSION",
        "SCALE_VALIDATION",
        "RESEARCH_PROPOSAL",
        "GENERAL_RESEARCH"
      ],
      "description": "Target graduate thesis or empirical pipeline."
    },
    "conceptual_roles": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "enum": [
          "Explorer",
          "Worker",
          "Critic",
          "Challenger",
          "Auditor",
          "Success Auditor"
        ]
      },
      "description": "Antigravity conceptual roles utilized in this academic pattern."
    },
    "workflow_stages": {
      "type": "array",
      "minItems": 2,
      "description": "Sequential ordered handoff stages across conceptual roles.",
      "items": {
        "type": "object",
        "required": [
          "stage_id",
          "stage_name",
          "conceptual_role",
          "domain_specialization",
          "assigned_agent",
          "required_skills",
          "input_artifacts",
          "output_artifacts",
          "exit_criteria"
        ],
        "properties": {
          "stage_id": {
            "type": "string",
            "pattern": "^STG-[A-Z0-9_-]+$"
          },
          "stage_name": {
            "type": "string",
            "minLength": 3
          },
          "conceptual_role": {
            "type": "string",
            "enum": [
              "Explorer",
              "Worker",
              "Critic",
              "Challenger",
              "Auditor",
              "Success Auditor"
            ]
          },
          "domain_specialization": {
            "type": "string",
            "description": "Domain title (e.g. 'Methodology Explorer', 'Statistical Worker', 'Methodology Critic')."
          },
          "assigned_agent": {
            "type": "string",
            "description": "Durable cognitive role from .agents/agents/ (e.g. 'methodology-expert', 'statistics-agent')."
          },
          "required_skills": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Production capabilities executed by this role."
          },
          "input_artifacts": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Artifacts received from previous stage or caller."
          },
          "output_artifacts": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Artifacts produced by this stage and handed off to next role."
          },
          "handoff_contract": {
            "type": "object",
            "description": "Structured payload schema passed to the next role."
          },
          "exit_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"},
            "description": "Checkpoints that must be verified before advancing to next role."
          },
          "workspace_mode": {
            "type": "string",
            "enum": ["inherit", "branch", "share"],
            "default": "inherit"
          }
        },
        "additionalProperties": false
      }
    },
    "governance": {
      "type": "object",
      "required": [
        "directive_0_binary_honesty",
        "directive_3_triad_invariant",
        "directive_6_english_filenames",
        "directive_12_sole_orchestrator"
      ],
      "properties": {
        "directive_0_binary_honesty": {"type": "boolean"},
        "directive_3_triad_invariant": {"type": "boolean"},
        "directive_6_english_filenames": {"type": "boolean"},
        "directive_12_sole_orchestrator": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "antigravity_execution_mode": {
      "type": "string",
      "enum": [
        "sequential_subagents",
        "dynamic_teamwork_preview",
        "hybrid"
      ],
      "default": "sequential_subagents",
      "description": "Execution pattern when invoked by Antigravity orchestrator."
    },
    "version": {
      "type": "string",
      "default": "1.0.0"
    }
  },
  "additionalProperties": false
}
