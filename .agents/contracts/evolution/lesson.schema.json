{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://academic-suite.net/contracts/evolution/lesson.schema.json",
  "title": "AcademicLessonContract",
  "description": "Contract schema for diagnosed episodic lessons. A lesson can exist persistently without becoming active production behavior. Distinguishes project-specific lessons from cross-project generalizations.",
  "type": "object",
  "required": [
    "contract_version",
    "lesson_id",
    "source_experience_id",
    "desired_behavior",
    "generalization",
    "scope",
    "confidence",
    "evidence",
    "related_skills",
    "is_active_behavior",
    "status",
    "target_agent",
    "target_agents",
    "created_at"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "lesson_id": {
      "type": "string",
      "description": "Unique identifier for this lesson record (e.g. LSN-2026-CH4-001)."
    },
    "lesson_type": {
      "type": "string",
      "enum": ["WHAT_NOT_TO_DO", "WHAT_WORKED_WELL"],
      "default": "WHAT_NOT_TO_DO",
      "description": "Distinguishes failure prevention lessons (WHAT NOT TO DO) from positive exemplar lessons (WHAT WORKED WELL)."
    },
    "trigger_source": {
      "type": "string",
      "enum": [
        "USER_FEEDBACK",
        "VALIDATOR_FAILURE",
        "CHALLENGER_FAILURE",
        "AUDITOR_FAILURE",
        "SUCCESSFUL_TRAJECTORY",
        "REPEATED_REVISION",
        "RECURRING_MISTAKE",
        "DELEGATION_AUDIT"
      ]
    },
    "source_experience_id": {
      "type": "string",
      "description": "Pointer to the originating experience ID (e.g. EXP-2026-CH4-001)."
    },
    "diagnosis": {
      "type": "object",
      "description": "Structured breakdown answering what happened, causal behavior, required behavior, and rationale.",
      "properties": {
        "what_happened": {"type": "string", "minLength": 5},
        "behavior_caused_outcome": {"type": "string", "minLength": 5},
        "what_should_have_happened": {"type": "string", "minLength": 5},
        "rationale_why": {"type": "string", "minLength": 5}
      },
      "additionalProperties": false
    },
    "applicability_conditions": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Explicit preconditions under which this lesson applies."
    },
    "exclusions": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Scenarios or designs where this lesson explicitly does not apply."
    },
    "observed_failure": {
      "type": "object",
      "required": ["defect_type", "description"],
      "properties": {
        "defect_type": {
          "type": "string",
          "enum": [
            "METHODOLOGICAL_DEFECT",
            "STATISTICAL_ASSUMPTION_VIOLATION",
            "DEGREES_OF_FREEDOM_MISMATCH",
            "REPORTING_OR_TYPOGRAPHY_DEFECT",
            "CITATION_OR_EVIDENCE_DISCORDANCE",
            "EXECUTION_OR_SCRIPT_FAILURE"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 5
        },
        "failing_artifact_path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "desired_behavior": {
      "type": "string",
      "minLength": 5,
      "description": "Specific correct behavior that should have occurred."
    },
    "generalization": {
      "type": "string",
      "minLength": 5,
      "description": "Abstract principle or reusable rule derived from the lesson."
    },
    "scope": {
      "type": "string",
      "enum": [
        "PROJECT_SPECIFIC",
        "DOMAIN_WIDE",
        "CROSS_PROJECT_UNIVERSAL"
      ],
      "description": "Distinguishes strictly project-specific lessons from generalized cross-project knowledge."
    },
    "generalization_stage": {
      "type": "string",
      "enum": [
        "OBSERVED",
        "LOCAL_LESSON",
        "REPEATED_PATTERN",
        "GENERALIZATION_CANDIDATE",
        "CROSS_CONTEXT_VALIDATION",
        "CROSS_DOMAIN_VALIDATION",
        "PROMOTED_PRINCIPLE"
      ],
      "default": "LOCAL_LESSON",
      "description": "Current position on the 7-stage generalization ladder."
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Statistical or epistemic confidence in this lesson (0.0 to 1.0)."
    },
    "confidence_evidence": {
      "type": "object",
      "description": "Evidence factors supporting the computed confidence score."
    },
    "evidence": {
      "type": "object",
      "required": ["metric_or_check", "observed_value", "threshold_value"],
      "properties": {
        "metric_or_check": {
          "type": "string"
        },
        "observed_value": {},
        "threshold_value": {},
        "supporting_report_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "supporting_artifact_paths": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "related_skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "List of skills implicated or guided by this lesson."
    },
    "is_active_behavior": {
      "type": "boolean",
      "description": "Flag explicitly indicating whether this lesson has been promoted to active production behavior. Defaults to false."
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "VALIDATED",
        "REJECTED",
        "SUPERSEDED",
        "RETIRED_OBSOLETE",
        "PROMOTED_TO_KNOWLEDGE"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "derived_by": {
      "type": "string",
      "description": "Diagnostician agent deriving the lesson (e.g. academic-challenger, statistical-auditor)."
    },
    "target_agent": {
      "type": "string",
      "description": "Optional subagent role to which this lesson is strictly targeted (e.g. academic-writer, statistics-agent, data-curator)."
    },
    "target_agents": {
      "type": "array",
      "items": {"type": "string"},
      "description": "List of subagent roles to which this lesson applies."
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_lessons": {
          "type": "array",
          "items": {"type": "string"}
        },
        "source_experiences": {
          "type": "array",
          "items": {"type": "string"}
        },
        "supporting_evaluations": {
          "type": "array",
          "items": {"type": "string"}
        },
        "consolidated_at": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "superseded_by": {
      "type": "string"
    },
    "superseded_at": {
      "type": "string"
    },
    "obsolete_reason": {
      "type": "string"
    },
    "retired_at": {
      "type": "string"
    },
    "graduation_track": {
      "type": "string",
      "enum": ["TRACK_1_IMMEDIATE_GRADUATION", "TRACK_2_CASE_SPECIFIC_LOCAL"],
      "description": "Directive 21 Dual-Track classification. Track 1 requires immediate graduation into SKILL.md by skill-evolver."
    },
    "graduation_status": {
      "type": "string",
      "enum": ["PENDING_GRADUATION", "GRADUATED", "NOT_APPLICABLE"],
      "description": "Graduation status under Directive 21."
    },
    "graduated_at": {
      "type": "string",
      "description": "ISO timestamp when this lesson was graduated into SKILL.md."
    },
    "graduated_targets": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Files into which this lesson was graduated."
    }
  },
  "additionalProperties": false
}
