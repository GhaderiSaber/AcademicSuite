{
  "track2-academic-orchestrator-guard": {
    "enabled": true,
    "description": "Track 2 Academic Governance Guard: Enforces Directive 20 tool stripping, CDE contracts, Triad artifacts, and stage validation for Academic Orchestrator and specialist subagents.",
    "PreToolUse": [
      {
        "matcher": "apply_diff|batch_replace|call_mcp_tool|define_subagent|edit_file|invoke_subagent|manage_subagents|manage_task|multi_file_edit|multi_replace_file_content|patch|read_resource|read_url_content|replace_file_content|run_command|schedule|send_message|view_file|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/hooks/track2_academic_dispatcher.py --event PreToolUse",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_diff|batch_replace|call_mcp_tool|define_subagent|edit_file|invoke_subagent|manage_subagents|manage_task|multi_file_edit|multi_replace_file_content|patch|read_resource|read_url_content|replace_file_content|run_command|schedule|send_message|view_file|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/hooks/track2_academic_dispatcher.py --event PostToolUse",
            "timeout": 15
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 .agents/hooks/track2_academic_dispatcher.py --event PreInvocation",
        "timeout": 15
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "python3 .agents/hooks/track2_academic_dispatcher.py --event PostInvocation",
        "timeout": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 .agents/hooks/track2_academic_dispatcher.py --event Stop",
        "timeout": 20
      }
    ]
  }
}
