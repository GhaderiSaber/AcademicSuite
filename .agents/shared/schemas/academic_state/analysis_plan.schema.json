{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AcademicAnalysisPlan",
  "type": "object",
  "required": [
    "significance_alpha",
    "planned_sequence",
    "variables"
  ],
  "properties": {
    "significance_alpha": {"type": "number", "minimum": 0.001, "maximum": 0.1},
    "power_target": {"type": "number", "minimum": 0.5, "maximum": 0.99},
    "bootstrap_resamples": {"type": "integer", "minimum": 1000},
    "planned_sequence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage_id", "title", "engine", "output_artifact"],
        "properties": {
          "stage_id": {"type": "string"},
          "title": {"type": "string"},
          "engine": {
            "type": "string",
            "enum": ["python", "r", "python_r"]
          },
          "script": {"type": "string"},
          "output_artifact": {"type": "string"},
          "assigned_subagent": {"type": "string"}
        }
      }
    },
    "variables": {
      "type": "object",
      "properties": {
        "independent": {"type": "array", "items": {"type": "string"}},
        "dependent": {"type": "array", "items": {"type": "string"}},
        "mediators": {"type": "array", "items": {"type": "string"}},
        "moderators": {"type": "array", "items": {"type": "string"}},
        "covariates": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "additionalProperties": true
}
