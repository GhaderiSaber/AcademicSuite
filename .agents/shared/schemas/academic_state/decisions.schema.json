{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AcademicDecisionsJournal",
  "type": "object",
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "decision_id",
          "timestamp",
          "category",
          "decision",
          "rationale",
          "agent"
        ],
        "properties": {
          "decision_id": {"type": "string"},
          "timestamp": {"type": "string"},
          "category": {
            "type": "string",
            "enum": [
              "methodology",
              "data_cleaning",
              "statistical_modeling",
              "reporting",
              "human_override"
            ]
          },
          "decision": {"type": "string"},
          "rationale": {"type": "string"},
          "alternatives_considered": {
            "type": "array",
            "items": {"type": "string"}
          },
          "agent": {"type": "string"},
          "supervisor_approval": {"type": "boolean"}
        }
      }
    }
  },
  "additionalProperties": true
}
