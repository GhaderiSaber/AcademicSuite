{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AcademicDescriptives",
  "type": "object",
  "required": ["sample_size", "variables"],
  "properties": {
    "sample_size": {"type": "integer"},
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "mean", "sd", "skewness", "kurtosis"],
        "properties": {
          "name": {"type": "string"},
          "label": {"type": "string"},
          "mean": {"type": "number"},
          "sd": {"type": "number"},
          "se": {"type": "number"},
          "min": {"type": "number"},
          "max": {"type": "number"},
          "skewness": {"type": "number"},
          "kurtosis": {"type": "number"}
        }
      }
    },
    "correlations": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
