{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AcademicSuite Orchestrator Manifest Schema",
  "description": "JSON contract for multi-stage academic research pipeline orchestrator manifests.",
  "type": "object",
  "required": ["project_id", "project_title", "preset", "stages"],
  "properties": {
    "project_id": { "type": "string" },
    "project_title": { "type": "string" },
    "preset": { "type": "string" },
    "orchestrator_version": { "type": "string" },
    "started_at": { "type": "string" },
    "completed_at": { "type": "string" },
    "overall_status": { "type": "string", "enum": ["pending", "in_progress", "completed", "failed"] },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage_number", "stage_name", "skill_name", "status"],
        "properties": {
          "stage_number": { "type": "integer" },
          "stage_name": { "type": "string" },
          "skill_name": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "running", "completed", "skipped", "failed"] },
          "artifacts_generated": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
