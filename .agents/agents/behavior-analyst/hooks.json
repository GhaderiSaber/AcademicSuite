{
  "behavior-analyst-guard": {
    "PreToolUse": [
      {
        "matcher": "invoke_subagent|define_subagent|write_to_file|replace_file_content|edit_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/agents/behavior-analyst/guard.py --event PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/agents/behavior-analyst/guard.py --event Stop",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
