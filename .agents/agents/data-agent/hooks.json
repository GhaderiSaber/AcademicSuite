{
  "data-agent-guard": {
    "PreToolUse": [
      {
        "matcher": "invoke_subagent|define_subagent|run_command|write_to_file|replace_file_content|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/agents/data-agent/guard.py --event PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/agents/data-agent/guard.py --event Stop",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
