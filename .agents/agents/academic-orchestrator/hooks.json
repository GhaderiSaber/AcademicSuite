{
  "academic-orchestrator-guard": {
    "PreToolUse": [
      {
        "matcher": "apply_diff|batch_replace|edit_file|invoke_subagent|manage_subagents|multi_file_edit|patch|replace_file_content|run_command|send_message|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/agents/academic-orchestrator/guard.py --event PreToolUse",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 .agents/agents/academic-orchestrator/guard.py --event Stop",
        "timeout": 20
      }
    ]
  }
}
