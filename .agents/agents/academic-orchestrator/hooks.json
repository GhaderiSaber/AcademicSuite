{
  "academic-orchestrator-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|edit_file|patch|multi_file_edit|batch_replace|apply_diff",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/agents/academic-orchestrator/guard.py --event PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/agents/academic-orchestrator/guard.py --event Stop",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
