{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "psychometric-data-simulator Output Schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "FAILED"
      ]
    },
    "results": {
      "type": "object",
      "description": "Structured domain results"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "status",
    "results"
  ]
}