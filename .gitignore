webapp/dist/

# Ignore Python bytecode and caches inside skills
__pycache__/
*.py[cod]
*$py.class
.DS_Store
*.DS_Store
*.session
*.session-journal
telethon_config.json
bot_config.json
userbot_storage/
bot_storage/
.agents/output/
.agents/memory/audit_log.jsonl
.agents/state/*.jsonl
.agents/state/*.json
!.agents/state/.gitkeep
state/*.jsonl
state/*.json
!state/.gitkeep

# Allow repository documentation, agent instructions, dependencies, and psychometric registry
!.gitignore
