# Ignore all files and folders in workspace by default
/*

# Allow Antigravity agent configurations & skills
!.agents/
!.github/
!webapp/
!projects/
!docs/
!evals/
!evaluations
!.agents/learning/
!.agents/learning/**
**/learning/evolution.lock
!legacy/
!config/
!config/**
!ANTIGRAVITY_ARCHITECTURE_GUIDE.md
webapp/node_modules/
webapp/dist/

# Ignore Python bytecode and caches inside skills
__pycache__/
*.py[cod]
*$py.class
.DS_Store
*.DS_Store
*.session
*.session-journal
telethon_config.json
bot_config.json
userbot_storage/
bot_storage/
.agents/output/
.agents/memory/audit_log.jsonl
.agents/state/*.jsonl
.agents/state/*.json
!.agents/state/.gitkeep
state/*.jsonl
state/*.json
!state/.gitkeep

# Allow repository documentation, agent instructions, dependencies, and psychometric registry
!.gitignore
!README.md
!AGENTS.md
!requirements.txt
!SETUP_GUIDE.md
!Questionnaires.xlsx
!digital_saber.py
!run_tests.py
!tests/
tests/fixtures/
tests/fixtures/**
tests/**/03_deliverables/
tests/**/academic-state/events.jsonl
tests/**/academic-state/current_state.json
*.session
*.session-journal
projects/**/raw_burnout_data.xlsx
projects/**/learning/
